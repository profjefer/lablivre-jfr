# ═══════════════════════════════════════════════════════════
#  .gitignore — LabLivre
#  Protege dados sensíveis e arquivos gerados em runtime
# ═══════════════════════════════════════════════════════════

# ─── CREDENCIAIS E DADOS SENSÍVEIS (NUNCA versionar!) ───
configs/lablivre.conf
configs/lablivre_key
configs/lablivre_key.pub
configs/.backups/

# ─── Lista de MACs do lab (específica de cada instalação) ───
configs/macs.txt

# ─── Arquivos gerados em runtime ───
ips_atuais.txt
logs/
web/api.json
web/auditoria.json
web/mapa_calor.json
web/inventario.html
web/status.html
web/relatorio_*.html
web/lablivre-raiz.txt
dashboards/

# ─── Cópias locais do macs.txt (ex.: macs-lablivre.txt, restauração) ───
configs/macs*.txt
configs/macs.txt.antes_de_restaurar
ips_atuais*.txt

# ─── Material didático (não versionar conteúdo de aula) ───
envia_material/*
!envia_material/.gitkeep

# ─── Pacotes gerados ───
# Só a pasta dist/ vai para o git (versão atual: .deb + projeto .tar.gz)
*.deb
*.tar.gz
!dist/
!dist/lablivre_*_all.deb
!dist/lablivre-*.tar.gz

# ─── Temporários e lixo ───
*.swp
*.swo
*~
*.tmp
/tmp/
.DS_Store

# ─── IDEs ───
.vscode/
.idea/
