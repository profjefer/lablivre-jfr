#!/bin/bash
set -e

# ============================================================
# postrm — Após remover o pacote
# ============================================================

# Guarda o macs.txt fora do /opt (autocontido: os módulos do pacote
# já foram apagados quando o postrm roda). Sobrevive ao purge.
salvar_macs() {
    local m=/opt/lablivre/configs/macs.txt d=/var/backups/lablivre
    grep -qE '^[[:space:]]*([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}[[:space:]]+[^[:space:]]' "$m" 2>/dev/null || return 0
    mkdir -p "$d" && chmod 755 "$d"
    cmp -s "$m" "$d/macs.txt" && return 0
    [ -f "$d/macs.txt" ] && cp -p "$d/macs.txt" "$d/macs_$(date '+%Y%m%d_%H%M%S').txt"
    cp -p "$m" "$d/macs.txt"
    ls -t "$d"/macs_*.txt 2>/dev/null | tail -n +11 | xargs -r rm -f
}

case "$1" in remove|purge) salvar_macs || true ;; esac

# Só numa remoção de verdade (remove/purge). Numa ATUALIZAÇÃO o dpkg
# também chama o postrm da versão antiga, com "upgrade": antes da 4.2.7
# isto apagava o serviço web, os wol-* e o cron a cada atualização.
case "$1" in
    remove|purge) ;;
    *) exit 0 ;;
esac

# Remove os symlinks
rm -f /usr/local/bin/lablivre
rm -f /usr/local/bin/lablivre-gui

# Descobre o usuário operador (mesmo critério do postinst)
USUARIO_REAL="${SUDO_USER:-}"
if [ -z "$USUARIO_REAL" ] || [ "$USUARIO_REAL" = "root" ]; then
    USUARIO_REAL=$(awk -F: '$3 >= 1000 && $3 < 65534 {print $1; exit}' /etc/passwd)
fi

# Remove serviço systemd do servidor web (em qualquer remoção)
systemctl disable lablivre-web.service 2>/dev/null || true
systemctl stop lablivre-web.service 2>/dev/null || true
rm -f /etc/systemd/system/lablivre-web.service
rm -f /etc/systemd/system/wol-*.service
systemctl daemon-reload 2>/dev/null || true

# Remove as tarefas do cron do usuário operador
if [ -n "$USUARIO_REAL" ] && id "$USUARIO_REAL" >/dev/null 2>&1; then
    crontab -u "$USUARIO_REAL" -l 2>/dev/null | grep -v "# LabLivre" | \
        crontab -u "$USUARIO_REAL" - 2>/dev/null || true
fi

# Em PURGE (remoção completa): apaga tudo, inclusive dados gerados e configs
if [ "$1" = "purge" ]; then
    rm -rf /opt/lablivre
    rm -rf /var/backups/lablivre/estado   # serviço/cron guardados: não voltam após purge
    echo "[postrm] LabLivre removido completamente (purge)."
    if [ -f /var/backups/lablivre/macs.txt ]; then
        echo "          O macs.txt foi guardado em /var/backups/lablivre/ e volta"
        echo "          sozinho se o LabLivre for instalado de novo."
        echo "          Para apagar também: sudo rm -rf /var/backups/lablivre"
    fi
else
    # Em remoção simples: mantém configs e dados, mas avisa
    echo "[postrm] LabLivre removido."
    echo "          Configurações e logs preservados em /opt/lablivre/"
    echo "          Para apagar tudo: sudo apt purge lablivre && sudo rm -rf /opt/lablivre"
fi

exit 0
