#!/bin/bash
set -e

# ============================================================
# preinst — Antes de instalar/atualizar o .deb
# ============================================================
# Guarda uma cópia do macs.txt FORA do /opt antes de mexer em
# qualquer coisa. (Autocontido: na instalação nova os módulos do
# LabLivre ainda não estão no disco.)

salvar_macs() {
    local m=/opt/lablivre/configs/macs.txt d=/var/backups/lablivre
    grep -qE '^[[:space:]]*([0-9A-Fa-f]{2}[:-]){5}[0-9A-Fa-f]{2}[[:space:]]+[^[:space:]]' "$m" 2>/dev/null || return 0
    mkdir -p "$d" && chmod 755 "$d"
    cmp -s "$m" "$d/macs.txt" && return 0
    [ -f "$d/macs.txt" ] && cp -p "$d/macs.txt" "$d/macs_$(date '+%Y%m%d_%H%M%S').txt"
    cp -p "$m" "$d/macs.txt"
    ls -t "$d"/macs_*.txt 2>/dev/null | tail -n +11 | xargs -r rm -f
    echo "[preinst] Cópia do macs.txt em $d/macs.txt"
}

# Guarda o que a opção 99 configurou fora do /opt: serviço web, serviços
# wol-* e as tarefas do cron. O postrm das versões até a 4.2.7 apagava
# tudo isso também numa ATUALIZAÇÃO; o postinst recoloca o que sumir.
# (Na atualização, este preinst roda ANTES do postrm da versão antiga.)
guardar_estado() {
    local d=/var/backups/lablivre/estado u f linhas
    [ -d /opt/lablivre ] || return 0
    mkdir -p "$d" && chmod 755 /var/backups/lablivre "$d"
    for f in /etc/systemd/system/lablivre-web.service /etc/systemd/system/wol-*.service; do
        [ -f "$f" ] && cp -p "$f" "$d/"
    done
    u=$(stat -c %U /opt/lablivre 2>/dev/null)
    if [ -n "$u" ] && [ "$u" != root ] && [ "$u" != UNKNOWN ]; then
        linhas=$(crontab -u "$u" -l 2>/dev/null | grep "# LabLivre" || true)
        # só troca a cópia se houver tarefas (não perde uma cópia boa)
        [ -n "$linhas" ] && printf '%s\n' "$linhas" > "$d/cron.txt" && echo "$u" > "$d/usuario"
    fi
    return 0
}

salvar_macs || true
guardar_estado || true
exit 0
